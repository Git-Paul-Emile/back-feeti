# ═══════════════════════════════════════════════════════════════════
#  feeti2 — Backend — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════════════════════

# ── Applications─────────────────────────────────────────────────────
NAME_APP="Féeti"
NODE_ENV=development                 # development | production

# ── Redis (queue emails) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379     # Redis 6.2+ requis (BullMQ)

# ── Base de données PostgreSQL ───────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/feeti2
# Exemple production : postgresql://user:pass@db.host.com:5432/feeti_prod

# ── JWT ─────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
ACCESS_TOKEN_SECRET=CHANGE_ME_RANDOM_64_BYTES_BASE64
REFRESH_TOKEN_SECRET=CHANGE_ME_RANDOM_64_BYTES_BASE64
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d

# ── Sécurité ────────────────────────────────────────────────────────
BCRYPT_SALT=10
TICKET_SECRET=CHANGE_ME_TICKET_HMAC_SECRET
# Chiffrement/signature des badges Feeti Access (QR codes de contrôle d'accès)
BADGE_SECRET=CHANGE_ME_BADGE_SECRET
# Code partagé permettant à un agent de terrain de s'authentifier sans compte
FEETI_ACCESS_AGENT_CODE=CHANGE_ME_AGENT_CODE

# ── URLs (CORS + cross-app + liens emails) ───────────────────────────
# Seul nom de variable utilisé dans tout le code pour l'URL du frontend
# (CORS, liens dans les emails, dashboard organisateur) — ne pas confondre
# avec un ancien FRONTEND_URL, retiré car source de confusion.
FRONT_URL=http://localhost:3000         # URL du frontend feeti2
API_URL=http://localhost:8000           # URL publique de cette API (liens de désinscription newsletter, QR, etc.)
FEETIPLAY_URL=http://localhost:5173     # URL du frontend feetiPlay
FEETIPLAY_API_URL=http://localhost:8001/api
FEETI2_API_URL=http://localhost:8000/api # URL de l'API Feeti2 (pour sync FeetiPlay → Feeti2)
FEETI_SYNC_SECRET=CHANGE_ME_SYNC_SECRET
# Origines CORS additionnelles, séparées par des virgules (ex: previews Vercel de confiance)
EXTRA_ALLOWED_ORIGINS=

# ── Email ─────────────────────────────────────────────────────────────
# Provider actif : Resend. Nodemailer (SMTP) est conservé en commentaire
# dans email.service.ts au cas où il faudrait revenir en arrière.
EMAIL_PROVIDER=resend                  # resend | nodemailer (désactivé)
EMAIL_FROM="Féeti <noreply@feeti.app>"

# SMTP (legacy — nodemailer, désactivé)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASS=votre_app_password_gmail     # App password Gmail (pas le mot de passe principal)
SMTP_FROM="Féeti <noreply@feeti.app>"  # Fallback si EMAIL_FROM n'est pas défini

# ── SMS ───────────────────────────────────────────────────────────────
# URL d'un webhook SMS externe. Si absent, les SMS sont simulés (loggés, non envoyés).
SMS_WEBHOOK_URL=

# ── Cloudinary (upload d'images) ─────────────────────────────────────
# Obtenir sur cloudinary.com > Dashboard > API Keys
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ── Paiements (Simulation — remplacer par les vraies clés en prod) ───
# Stripe
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX          # clé secrète Stripe (backend)
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX        # webhook secret Stripe

# Paystack
PAYSTACK_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX

# ── Paramètres financiers ────────────────────────────────────────────
PAYOUT_DOUBLE_VALIDATION_THRESHOLD=100000  # Montant (centimes) déclenchant double validation

# ── Dialogflow (Chatbot FAQ) ──────────────────────────────────────────
# Obtenir sur console.cloud.google.com > IAM > Comptes de service > Clés JSON
DIALOGFLOW_PROJECT_ID=your-gcp-project-id
DIALOGFLOW_CLIENT_EMAIL=dialogflow-sa@your-project.iam.gserviceaccount.com
DIALOGFLOW_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nXXXXXX\n-----END RSA PRIVATE KEY-----\n"

# ── PandaDoc (génération de contrats organisateurs) ──────────────────
PANDADOC_API_KEY=CHANGE_ME_PANDADOC_API_KEY
PANDADOC_TEMPLATE_ID=CHANGE_ME_TEMPLATE_UUID
PANDADOC_DIRECTOR_NAME="Directeur Féeti"
PANDADOC_DIRECTOR_EMAIL=directeur@feeti.app

# ── Firestore Sync (PostgreSQL → Firestore) ──────────────────────────
# Activer la synchronisation PostgreSQL → Firestore
FIRESTORE_SYNC_ENABLED=false            # true | false (désactivé par défaut)

# ── Firebase Admin (authentification uniquement) ─────────────────────
# JSON complet du compte de service, sur une seule ligne (recommandé en prod/Render).
# En dev, si absent, on retombe sur le fichier back/firebase-service-account.json.
# Même nom de variable que côté FeetiPlayWeb pour rester cohérent entre les deux apps.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Resend (email) ───────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM="Feeti <no-reply@feeti.example>"

# ── Divers ───────────────────────────────────────────────────────
PORT=8000
# Base URL publique des logos utilisés dans les emails
EMAIL_LOGO_BASE_URL=https://feeti.example/assets
