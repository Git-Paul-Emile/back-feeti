NAME_APP="Féeti"
NODE_ENV=production

# URLs — remplacer après déploiement Vercel/Render
# FRONT_URL doit pointer vers ton frontend Vercel
FRONT_URL=https://front-feeti.vercel.app
FEETIPLAY_URL=https://feet-play-front.vercel.app
FEETIPLAY_API_URL=https://feetiplay-back.onrender.com/api

# Supabase — deux URLs nécessaires pour Prisma 6
# DATABASE_URL  : URL poolée (Transaction pooler, port 6543) — pour les requêtes runtime
# DIRECT_URL    : URL directe (port 5432) — pour prisma migrate deploy
# Les deux sont dans : Supabase → Settings → Database → Connection string
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Redis — Upstash (gratuit) : https://upstash.com → Redis → Create → copier REDIS_URL
REDIS_URL=rediss://default:[password]@[host].upstash.io:6379

# JWT — générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=REMPLACER_PAR_SECRET_FORT_64_CHARS
REFRESH_TOKEN_SECRET=REMPLACER_PAR_SECRET_FORT_64_CHARS
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d
BCRYPT_SALT=10
FEETI_SYNC_SECRET=REMPLACER_PAR_SECRET_ALEATOIRE

# Cloudinary (images) : https://cloudinary.com → Dashboard → API Keys
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Email SMTP (Gmail : activer 2FA puis créer un App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton_email@gmail.com
SMTP_PASS=ton_app_password_gmail
EMAIL_FROM="Féeti <noreply@feeti.io>"

# Firestore sync (false en prod si pas nécessaire)
FIRESTORE_SYNC_ENABLED=false

# Seuil double validation payouts (en centimes)
PAYOUT_DOUBLE_VALIDATION_THRESHOLD=100000
